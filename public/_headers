# Cloudflare serves static assets as
#   cache-control: public, max-age=0, must-revalidate
# so every play of an already cached track still costs a round trip.
# The tracks are content addressed by name and are never edited in place:
# reordering the set is done by renaming files, so a given name always
# holds the same bytes. That is what makes immutable honest here.
#
# MUSIC ONLY. The HTML is deliberately left on the default, because a
# stale index.html is a far worse failure than a slow track: every push
# to main is live within a minute and a year long cache on the page
# would strand players on whatever shipped first.
/music/*
  Cache-Control: public, max-age=31536000, immutable
